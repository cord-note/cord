# Dependencies / build output
node_modules/
dist/
target/

# Local app data
.cord/
*.db
*.db-shm
*.db-wal

# Tauri generated + prebuilt sidecar binaries.
# Leading **/ so these match under apps/desktop/, not just the repo root —
# a mid-string slash without it anchors the pattern to this file's directory.
**/src-tauri/gen/
**/src-tauri/binaries/

# Tooling caches
.impeccable/

# AI assistant and local-workspace files. None of this is part of the app, and
# it is workspace-specific — instructions, session state and editor config that
# would only mislead anyone reading the published repository.
.claude/
.cursor/
.cursorrules
.aider*
.windsurfrules
.continue/
CLAUDE.md
AGENTS.md
GEMINI.md
.vscode/
.idea/
*.code-workspace

# Scratch space
scratchpad/
tmp/
*.local.json
