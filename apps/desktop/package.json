{
  "name": "@cord/desktop",
  "version": "2.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cord-note/cord.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run build:sidecar:host && tauri dev",
    "dev:sidecar": "bun --watch src/sidecar/index.ts",
    "build:sidecar:host": "bun scripts/build-sidecar-host.ts",
    "dev:renderer": "vite",
    "dev:all": "concurrently -k -n sidecar,vite -c cyan,green \"bun run dev:sidecar\" \"bun run dev:renderer\"",
    "build": "bun run build:renderer && bun run build:sidecar",
    "build:renderer": "vite build",
    "build:sidecar": "bun build --compile --target=bun-linux-x64 src/sidecar/index.ts --outfile src-tauri/binaries/cord-sidecar-x86_64-unknown-linux-gnu && bun build --compile --target=bun-windows-x64 src/sidecar/index.ts --outfile src-tauri/binaries/cord-sidecar-x86_64-pc-windows-msvc && bun build --compile --target=bun-darwin-arm64 src/sidecar/index.ts --outfile src-tauri/binaries/cord-sidecar-aarch64-apple-darwin",
    "tauri": "tauri",
    "test": "CORD_DB_PATH=:memory: bun test src",
    "test:watch": "CORD_DB_PATH=:memory: bun test --watch src",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "jsonc-parser": "^3.3.1",
    "katex": "^0.16.45",
    "lucide-react": "^1.49.0",
    "nanoid": "^3.3.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "shuttle-editor": "^0.3.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.21.4",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "vite": "^6.4.3"
  }
}
