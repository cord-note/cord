{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cord",
  "version": "1.6.0",
  "identifier": "app.cord.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "Cord",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "publisher": "Aleksander Sprengel",
    "copyright": "Copyright (c) 2026 Aleksander Sprengel",
    "category": "Productivity",
    "shortDescription": "Local-first note-taking as a knowledge graph.",
    "longDescription": "Cord is a local-first desktop note-taking app. Vaults, notes, links and tags form a knowledge graph rather than a filing cabinet. Your notes live in a SQLite database on your own machine.",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cord-sidecar"]
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
