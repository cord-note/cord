{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cord",
  "version": "2.0.0",
  "identifier": "app.cord.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "Cord",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "createUpdaterArtifacts": true,
    "publisher": "Aleksander Sprengel",
    "copyright": "Copyright (c) 2026 Aleksander Sprengel",
    "category": "Productivity",
    "shortDescription": "Local-first note-taking as a knowledge graph",
    "longDescription": "Cord is a local-first desktop note-taking app. Vaults, notes, links and tags form a knowledge graph rather than a filing cabinet. Your notes live in a SQLite database on your own machine.",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cord-sidecar"],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "section": "utils",
        "priority": "optional",
        "files": {
          "/usr/share/metainfo/app.cord.desktop.metainfo.xml": "app.cord.desktop.metainfo.xml"
        }
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"],
        "release": "1",
        "files": {
          "/usr/share/metainfo/app.cord.desktop.metainfo.xml": "app.cord.desktop.metainfo.xml"
        }
      }
    }
  },
  "plugins": {
    "shell": {
      "open": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGMUVENTE1RTFDN0IwNTQKUldSVXNNZmhGZFVlYjJZRVdabFN2eXd2djhzNTJwYng3NjlwQWNNQTB6VHA5SGE1V0pzT2JzZUYK",
      "endpoints": [
        "https://github.com/cord-note/cord/releases/latest/download/latest.json"
      ]
    }
  }
}
